includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        # Hosts for the Livewire traits only the Blade pages use (see that folder).
        # The rest of tests/ stays out: see .ai/rules/enums.md.
        - tests/PHPStan/

    level: 7

    # Each entry is a place PHPStan's view contradicts what really runs.
    # Keep them narrow (one identifier, one file, an exact count); an entry
    # that stops matching fails the run, so a stale one cannot linger.
    ignoreErrors:
        -
            # User::delete() runs SQL; a row still referenced by a restricting
            # foreign key throws QueryException. Model::delete()'s @throws lists
            # only LogicException, so PHPStan calls the catch dead.
            identifier: catch.neverThrown
            path: app/Models/User.php
            count: 1
        -
            # $user->email reads the HR database, which can fail; a log line must
            # never break the sign-in it describes. Accessors declare no @throws.
            identifier: catch.neverThrown
            path: app/Listeners/LogAuthenticationEvent.php
            count: 1
        -
            # Seeder::$command is documented as non-null but is only set when the
            # seeder runs from artisan or another seeder's call(); Laravel's own
            # Seeder guards it with isset() for the same reason.
            identifier: nullsafe.neverNull
            path: database/seeders/NotificationDemoSeeder.php
            count: 2
        -
            # activeAnchor() and activeMonth() were moved here unchanged from the
            # calendar, milestones and tasks pages. They still test
            # createFromFormat() against false (Carbon 2 style); Carbon 3 returns
            # null instead, and the regex before each call already rules out a
            # failed parse. Switching the check to null is a logic change, so it
            # waits for its own task.
            identifier: notIdentical.alwaysTrue
            path: app/Livewire/Concerns/NavigatesCalendarPeriods.php
            count: 2

        # The proposals/show traits below hold code moved unchanged from the
        # page, which PHPStan could not read before. Changing any of it is a
        # logic change, so each entry waits for its own task.
        -
            # chronology() reads a tranche currency as `(...)?->value ?? ''`.
            # transfers_tracking.amount_*_currency are NOT NULL (default USD), so
            # PHPStan calls the `?? ''` fallback dead.
            identifier: nullCoalesce.expr
            path: app/Livewire/Concerns/Proposals/ChartsProposalChronology.php
            count: 1
        -
            # chronology() skips a status note whose date is null;
            # proposal_status_notes.date is NOT NULL (useCurrent()), so the check
            # can never be true.
            identifier: identical.alwaysFalse
            path: app/Livewire/Concerns/Proposals/ChartsProposalChronology.php
            count: 1
        -
            # laneLabels() returns its labels with a lane and an anchor added.
            # PHPStan cannot express "template T plus two keys", so the docblock
            # says list<T> and the added keys are reported as breaking T.
            identifier: return.type
            path: app/Livewire/Concerns/Proposals/ChartsProposalChronology.php
            count: 1
        -
            # openDetailsModal() reads planned_date_begin/end as
            # `?->toDateString() ?? ''`; proposals.planned_date_* are NOT NULL, so
            # PHPStan calls the `?? ''` fallback dead.
            identifier: nullCoalesce.expr
            path: app/Livewire/Concerns/Proposals/ManagesProposalRecord.php
            count: 2
        -
            # The same two lines in openDetailsModal(): the `?->` on a NOT NULL
            # planned date is reported as never meeting null.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Proposals/ManagesProposalRecord.php
            count: 2
        -
            # agreementMoney() compares `amount_received_currency?->value` and
            # `amount_transfered_currency?->value`; both columns are NOT NULL
            # (default USD), so the `?->` is reported as never meeting null.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Proposals/ReadsProposalFunding.php
            count: 4
        -
            # deadlines() has two: `amount_transfered_currency?->value` (NOT NULL
            # column), and `planIndicator->project?->name ?? organisation_wide`.
            # plan_indicators.project_id IS nullable and that fallback names an
            # organisation-wide target on purpose: keep it. PHPStan flags only
            # the `?->`, which is redundant on the left of `??`.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Proposals/ReadsProposalHealth.php
            count: 2
        -
            # deadlines() tests $grantEnd (actual end ?? planned end) and
            # warnings() tests planned_date_end against null;
            # proposals.planned_date_end is NOT NULL, so both are always true.
            identifier: notIdentical.alwaysTrue
            path: app/Livewire/Concerns/Proposals/ReadsProposalHealth.php
            count: 2
        -
            # tasks() eager-loads `source` with a callback typed for the MorphTo
            # it receives (it calls morphWith()); Larastan types every with()
            # callback as taking any Relation.
            message: '#MorphTo#'
            identifier: argument.type
            path: app/Livewire/Concerns/Proposals/ReadsProposalDelivery.php
            count: 1

        # Raw SQL that cannot be a literal string but carries no user input.
        # Checked 2026-10-05: every value inside is an enum value, a date this
        # code formats itself, or a whitelisted sort direction. Bind anything
        # a user can type with ? placeholders instead of adding an entry here.
        -
            # The funding money SQL (stateSql() and the figures built on it) is
            # one definition, nested fragment inside fragment; the only runtime
            # values are today's date and a year's bounds (sprintf('%04d', int)).
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Models/TransfersTracking.php
            count: 4
        -
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Support/AccountMoney.php
            count: 2
        -
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Support/AgreementMoney.php
            count: 1
        -
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Models/DonorProposal.php
            count: 1
        -
            # Sort terms are SQL each register page writes in its own code; only
            # the direction varies and activeSortDir() limits it to asc/desc.
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Livewire/Concerns/FiltersFinanceRegister.php
            count: 1
