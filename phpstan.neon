        # The admin/users traits hold code moved unchanged from the page, which
        # PHPStan could not read before. The entries below are typing gaps in
        # Laravel and Spatie. Some could be retired by hoisting a local, but the
        # moved code is deliberately kept verbatim.
        -
            # saveUserAccess() records the role and permission change from
            # `$user->roles()->pluck('name')->all()` (and the permissions
            # twin). Builder::pluck() returns Collection<array-key, mixed>, so
            # ->all() is array<mixed> and PHPStan cannot prove the
            # list<string> recordRoleChange() / recordPermissionChange() ask
            # for. The values are Spatie's name column, a plain string.
            message: '#expects list<string>, array<mixed> given#'
            identifier: argument.type
            path: app/Livewire/Concerns/Admin/ManagesUserAccess.php
            count: 4
        -
            # selectedRoleUsers() calls $this->selectedRole->users(). Spatie's
            # Role::users() builds its morphedByMany from the guard's user
            # model at run time (getModelForGuard()), so PHPStan types the
            # relation as Model rather than App\Models\User; the docblock and
            # the closure's User type hint state what the guard really holds.
            message: '#should return .*Collection<int, App.Models.User> but returns#'
            identifier: return.type
            path: app/Livewire/Concerns/Admin/ManagesRoles.php
            count: 1
        -
            # The sortBy() closure in selectedRoleUsers() is typed for
