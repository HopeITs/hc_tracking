            message: '#sortBy\(\) expects#'
            identifier: argument.type
            path: app/Livewire/Concerns/Admin/ManagesRoles.php
            count: 1
        -
            # showAssignedUsers() passes the nullable int $selectedRoleId to
            # abort_unless(). Laravel's helper declares the parameter untyped
            # (`@param bool $boolean` in its docblock, helpers.php) and only
