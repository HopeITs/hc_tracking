            # and PHPStan does not apply it there. Loosening the @return does not
            # help either: matching what PHPStan infers means `result: mixed` and
            # a bare Collection, which drops the shape instead of fixing it.
            identifier: return.type
            path: app/Livewire/Concerns/AnnualPlans/ReadsAnnualPlanSummary.php
            count: 1
        -
            # deliveryWindow() reads `$project?->start_date ?? $project?->end_date`
