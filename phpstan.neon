includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        # Hosts for the Livewire traits only the Blade pages use (see that folder).
        # The rest of tests/ stays out: see .ai/rules/enums.md.
        - tests/PHPStan/

    level: 7

    # Each entry is a place PHPStan's view contradicts what really runs.
    # Keep them narrow (one identifier, one file, an exact count); an entry
    # that stops matching fails the run, so a stale one cannot linger.
    ignoreErrors:
        -
            # User::delete() runs SQL; a row still referenced by a restricting
            # foreign key throws QueryException. Model::delete()'s @throws lists
            # only LogicException, so PHPStan calls the catch dead.
            identifier: catch.neverThrown
            path: app/Models/User.php
            count: 1
        -
            # $user->email reads the HR database, which can fail; a log line must
            # never break the sign-in it describes. Accessors declare no @throws.
            identifier: catch.neverThrown
            path: app/Listeners/LogAuthenticationEvent.php
            count: 1
        -
            # Seeder::$command is documented as non-null but is only set when the
            # seeder runs from artisan or another seeder's call(); Laravel's own
            # Seeder guards it with isset() for the same reason.
            identifier: nullsafe.neverNull
            path: database/seeders/NotificationDemoSeeder.php
            count: 2

        # The proposals/show traits below hold code moved unchanged from the
        # page, which PHPStan could not read before. Changing any of it is a
        # logic change, so each entry stays.
        -
            # chronology() reads a tranche currency as `(...)?->value ?? ''`.
            # transfers_tracking.amount_*_currency are NOT NULL (default USD), so
            # PHPStan calls the `?? ''` fallback dead.
            identifier: nullCoalesce.expr
            path: app/Livewire/Concerns/Proposals/ChartsProposalChronology.php
            count: 1
        -
            # chronology() skips a status note whose date is null;
            # proposal_status_notes.date is NOT NULL (useCurrent()), so the check
            # can never be true.
            identifier: identical.alwaysFalse
            path: app/Livewire/Concerns/Proposals/ChartsProposalChronology.php
            count: 1
        -
            # laneLabels() returns its labels with a lane and an anchor added.
            # PHPStan cannot express "template T plus two keys", so the docblock
            # says list<T> and the added keys are reported as breaking T.
            identifier: return.type
            path: app/Livewire/Concerns/Proposals/ChartsProposalChronology.php
            count: 1
        -
            # agreementMoney() compares `amount_received_currency?->value` and
            # `amount_transfered_currency?->value`; both columns are NOT NULL
            # (default USD), so the `?->` is reported as never meeting null.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Proposals/ReadsProposalFunding.php
            count: 4
        -
            # deadlines() has two: `amount_transfered_currency?->value` (NOT NULL
            # column), and `planIndicator->project?->name ?? organisation_wide`.
            # plan_indicators.project_id IS nullable and that fallback names an
            # organisation-wide target on purpose: keep it. PHPStan flags only
            # the `?->`, which is redundant on the left of `??`.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Proposals/ReadsProposalHealth.php
            count: 2
        -
            # deadlines() tests $grantEnd (actual end ?? planned end) and
            # warnings() tests planned_date_end against null;
            # proposals.planned_date_end is NOT NULL, so both are always true.
            identifier: notIdentical.alwaysTrue
            path: app/Livewire/Concerns/Proposals/ReadsProposalHealth.php
            count: 2
        -
            # tasks() eager-loads `source` with a callback typed for the MorphTo
            # it receives (it calls morphWith()); Larastan types every with()
            # callback as taking any Relation.
            message: '#MorphTo#'
            identifier: argument.type
            path: app/Livewire/Concerns/Proposals/ReadsProposalDelivery.php
            count: 1
        -
            # agendaBetween() eager-loads a task's `source` with a callback typed
            # for the MorphTo it receives (it calls morphWith()); Larastan types
            # every with() callback as taking any Relation.
            message: '#MorphTo#'
            identifier: argument.type
            path: app/Livewire/Concerns/Desk/ReadsDeskAgenda.php
            count: 1

        # The calendar/index traits below hold code moved unchanged from the
        # page, which PHPStan could not read before. Changing any of it is a
        # logic change, so each entry stays.
        -
            # typeProperty() matches the seven known type keys with no default.
            # Every caller passes one of them: toggleType(), the one public
            # action that reaches it, returns first when canSeeType() rejects
            # the key, and canSeeType() rejects any key outside the seven.
            identifier: match.unhandled
            path: app/Livewire/Concerns/Calendar/FiltersCalendarTypes.php
            count: 1
        -
            # focusedItems() reads `planIndicator?->indicator?->name ?? fallback`.
            # The fallback is wanted (a report's indicator can be gone); PHPStan
            # flags only the last `?->`, redundant on the left of `??`.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Calendar/FindsFocusedTypeDates.php
            count: 1
        -
            # focusedItems() documents title as string and date as non-null.
            # The rows put __() (string|array to PHPStan) in title/subLabel and
            # read due_date/next_step_due_on, nullable casts the queries already
            # filter with whereNotNull().
            identifier: return.type
            path: app/Livewire/Concerns/Calendar/FindsFocusedTypeDates.php
            count: 1
        -
            # saveMilestone() reads `$existingMilestone?->project_id ?? (int) ...`;
            # the `?->` is redundant on the left of `??`.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Calendar/ManagesCalendarMilestones.php
            count: 1
        -
            # saveMilestone() passes Rule::in(...) to Rule::when(). Rules\In is a
            # valid rule object at runtime, but Rule::when()'s signature does not
            # list it.
            identifier: argument.type
            path: app/Livewire/Concerns/Calendar/ManagesCalendarMilestones.php
            count: 1
        -
            # dayDetailItems() reads `planIndicator?->indicator?->name ?? fallback`;
            # same as focusedItems() above.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Calendar/ShowsCalendarDay.php
            count: 1

        # The indicators/index traits below hold code moved unchanged from the
        # page, which PHPStan could not read before. Same rule as above.
        -
            # allIndicators() eager-loads `planIndicators.source` with a callback
            # typed for the MorphTo it receives (it calls morphWith()); Larastan
            # types every with() callback as taking any Relation.
            message: '#MorphTo#'
            identifier: argument.type
            path: app/Livewire/Concerns/Indicators/BuildsIndicatorRows.php
            count: 1
        -
            # describeTarget() documents sourceLabel as string|null and donors as
            # list<string>. sourceLabel can hold __('common.fy_year', ...), which
            # PHPStan types as string|array (that key always resolves to a
            # string), and donors is pluck('name')->values()->all(), which PHPStan
            # types as array<int, mixed> (not a list, values untyped). The
            # docblock states the exact shape the page relies on, so it stays.
            identifier: return.type
            path: app/Livewire/Concerns/Indicators/BuildsIndicatorRows.php
            count: 1
        -
            # changeKeepsTargetsInChain() eager-loads `source` with a callback
            # typed for the MorphTo it receives; same as allIndicators() above.
            message: '#MorphTo#'
            identifier: argument.type
            path: app/Livewire/Concerns/Indicators/ManagesIndicatorForm.php
            count: 1

        # Raw SQL that cannot be a literal string but carries no user input.
        # Checked 2026-10-05: every value inside is an enum value, a date this
        # code formats itself, or a whitelisted sort direction. Bind anything
        # a user can type with ? placeholders instead of adding an entry here.
        -
            # The funding money SQL (stateSql() and the figures built on it) is
            # one definition, nested fragment inside fragment; the only runtime
            # values are today's date and a year's bounds (sprintf('%04d', int)).
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Models/TransfersTracking.php
            count: 4
        -
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Support/AccountMoney.php
            count: 2
        -
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Support/AgreementMoney.php
            count: 1
        -
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Models/DonorProposal.php
            count: 1
        -
            # Sort terms are SQL each register page writes in its own code; only
            # the direction varies and activeSortDir() limits it to asc/desc.
            # Counted once per host class that uses the trait (FinanceRegisterHost,
            # ProposalsIndexPageHost, TransfersIndexPageHost, DonorsIndexPageHost,
            # FundingAgreementsIndexPageHost and AdminAccountsPageHost).
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Livewire/Concerns/FiltersFinanceRegister.php
            count: 6
        -
            # orderByEnumSequence() builds a CASE from the fixed value lists
            # applySort() passes (priority and status cases) and a direction it
            # limits to asc/desc. orderByAssigneeName() builds one from task ids
            # cast to int and list positions.
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Livewire/Concerns/Tasks/FiltersTaskDirectory.php
            count: 3
        -
            # taskStats() inlines two dates it formats itself (toDateString())
            # into one aggregate select; there is no user input in it.
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Livewire/Concerns/Tasks/ReadsTaskViews.php
            count: 1

        # The proposals/index traits hold code moved unchanged from the page,
        # which PHPStan could not read before. Changing any of it is a logic
        # change.
        -
            # agreementMoney() compares `amount_received_currency?->value` and
            # `amount_transfered_currency?->value`; both columns are NOT NULL
            # (default USD), so the `?->` is reported as never meeting null.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Proposals/ChartsProposalPipeline.php
            count: 5
        -
            # togglePhase() reads `ProposalPhase::tryFrom($phase)?->value ?? ''`.
            # tryFrom() does return null; PHPStan only objects that `??` already
            # covers null, so the `?->` is redundant.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Proposals/ReadsProposalRegister.php
            count: 1
        -
            # selectLine() and totals() pass AgreementMoney::ownerSelect() and
            # ownerTotalsSelect('proposals.id') to selectRaw(). Both build the
            # list from fixed column names; ownerTotalsSelect() also checks its
            # key against a pattern.
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Livewire/Concerns/Proposals/ReadsProposalRegister.php
            count: 2
        -
            # flow() maps each funded proposal and project through
            # `collect($row)->except('projects')->all()` (and 'row'), which
            # PHPStan reads as array<string, mixed>; the docblock states the exact
            # shapes the Overview view relies on, so it stays.
            identifier: return.type
            path: app/Livewire/Concerns/Proposals/ChartsProposalPipeline.php
            count: 1
        -
            # registerSorts() builds its date columns with a closure whose $dir is
            # a plain string; every call passes 'desc', but PHPStan cannot see that
            # and reports it against the declared 'asc'|'desc'. Reported once per
            # return statement.
            identifier: return.type
            path: app/Livewire/Concerns/Proposals/ReadsProposalRegister.php
            count: 3

        # The results/index traits below hold code moved unchanged from the page.
        # PHPStan could not read the page, so these are new findings; each needs a
        # logic change, so each entry stays.
        -
            # describeTarget() documents sourceLabel as string|null and donors as
            # list<string>. sourceLabel can hold __('common.fy_year', ...), which
            # PHPStan types as string|array (that key always resolves to a
            # string), and donors is pluck('name')->values()->all(), which PHPStan
            # types as array<int, mixed> (not a list, values untyped). The
            # docblock states the exact shape the page relies on, so it stays.
            identifier: return.type
            path: app/Livewire/Concerns/Results/BuildsResultsFramework.php
            count: 1
        -
            # groupedRoots() reads a statement's program as `program?->name ??
            # unassigned`. results.program_id IS nullable (nullOnDelete), so the
            # fallback is what puts program-less statements in the Unassigned
            # group; PHPStan only flags the `?->` as redundant on the left of `??`.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Results/BuildsResultsTree.php
            count: 1
        -
            # overview() bumps $levels[$level][...] for a string $level; PHPStan
            # cannot tell that every ResultType value was seeded with all three
            # counters, so it reports the keys as possibly missing.
            identifier: offsetAccess.notFound
            path: app/Livewire/Concerns/Results/SummarisesResults.php
            count: 2
        -
            # The same $levels array: after those increments PHPStan reads
            # `measured` / `indicators` as optional, so the declared `levels` shape
            # in the return docblock no longer matches.
            identifier: return.type
            path: app/Livewire/Concerns/Results/SummarisesResults.php
            count: 1

        # The projects/show traits below hold code moved unchanged from the page,
        # which PHPStan could not read before. Eloquent\Collection::map() types
        # its callback argument from TModel, so after groupBy() each group (itself
        # a Collection) reads as a Model and `$group->first()->…` is mixed; a
        # typed @param on the closure does not clear it. `->toBase()` between
        # groupBy() and map() does (ReadsProjectFunding uses it); the entries
        # below stay because there it would surface findings that need logic
        # changes.
        -
            # targetsByResult(): the same Eloquent groupBy()/map() typing makes
            # `first()->indicator(->result)` mixed, so the declared Result /
            # Indicator / PlanIndicator shape is reported. Fixing the types with
            # `->toBase()` would surface real findings that need logic changes:
            # result/indicator are nullable (BelongsTo + first()), and the
            # `$resultOrder[...] ?? 99` fallback is dead (ResultType has only
            # those three cases).
            identifier: return.type
            path: app/Livewire/Concerns/Projects/ReadsProjectDelivery.php
            count: 1
        -
            # The same chain: sortBy()'s callback reads `$group['result']->type`
            # from that mis-typed shape, which PHPStan cannot resolve.
            identifier: argument.unresolvableType
            path: app/Livewire/Concerns/Projects/ReadsProjectDelivery.php
            count: 1
        -
            # The same chain: values() after that sortBy() returns the
            # unresolvable type.
            identifier: method.unresolvableReturnType
            path: app/Livewire/Concerns/Projects/ReadsProjectDelivery.php
            count: 1

        # The targets/index traits below hold code moved unchanged from the page,
        # which PHPStan could not read before. Same rule as above.
        -
            # portfolio() groups Reports with groupBy() and maps each group in a
            # closure typed with the bare Eloquent Collection (element type
            # Model), so the returned shape degrades: project is mixed, reports
            # is Collection<int, Model> and latest is Model|null (first() is
            # nullable, though a group is never empty). The docblock states the
            # real shape the partial relies on, so it stays.
            message: '#portfolio\(\) should return#'
            identifier: return.type
            path: app/Livewire/Concerns/Reports/ReadsReportPortfolio.php
            count: 1
        -
            # targets() eager-loads `source` with a callback typed for the MorphTo
            # it receives (it calls morphWith()); Larastan types every with()
            # callback as taking any Relation.
            message: '#MorphTo#'
            identifier: argument.type
            path: app/Livewire/Concerns/Targets/ReadsTargets.php
            count: 1
        -
            # saveTarget() loads the original row's `source` the same way, to
            # compare its chain issues with the edited ones.
            message: '#MorphTo#'
            identifier: argument.type
            path: app/Livewire/Concerns/Targets/ManagesTargetForm.php
            count: 1

        # The executive-summary/index traits hold code moved unchanged from the
        # page, which PHPStan could not read before. Changing any of it is a
        # logic change.
        -
            # Eleven redundant `?->`. Nine sit on the left of `??`, which already
            # covers null: targetsByProgram() (`?->program_id ?? 0`,
            # `$program?->name ?? …`), and the `?->id ?? 0` / `?->name ?? …`
            # pairs in moneyByAgreement(), milestonesByProject() and
            # reportsByIndicator() (which also reads `planIndicator?->indicator_id
            # ?? 0`). The other two are moneyByAgreement()'s
            # `amount_transfered_currency?->value` and
            # `amount_received_currency?->value`; both columns are NOT NULL
            # (default USD), so the `?->` is reported as never meeting null.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/ExecutiveSummary/LoadsSummarySources.php
            count: 11

        # The funding-agreements/show traits hold code moved unchanged from the
        # page, which PHPStan could not read before. Changing any of it is a
        # logic change, so each entry stays.
        -
            # term() reads begin/end as `actual_date_* ?? planned_date_*` and
            # returns early when either is null. proposals.planned_date_begin and
            # planned_date_end are NOT NULL, so after the `??` neither can be null
            # and both `=== null` checks are reported as always false.
            identifier: identical.alwaysFalse
            path: app/Livewire/Concerns/FundingAgreements/ReadsAgreementMoney.php
            count: 2
        -
            # journeys() documents each stop label and the timing line as
            # string. Both can hold a __() result, which PHPStan types as
            # string|array (the keys used always resolve to strings), so the
            # declared shape is reported.
            identifier: return.type
            path: app/Livewire/Concerns/FundingAgreements/ReadsAgreementMoney.php
            count: 1

        # The transfers/index traits hold code moved unchanged from the page,
        # which PHPStan could not read before. Changing any of it is a logic
        # change, so each entry stays.
        -
            # filteredQuery(), groupOrder() and applySort() pass SQL built from
            # TransfersTracking's own state fragments (one definition, with only
            # today's date inlined) and, for the month grouping, a column name
            # looked up in TransfersTracking::DATE_COLUMNS by dateBasis, which
            # normaliseFilters() limits to the three known bases. Anything the
            # user types is bound with ? placeholders. Typed plain string.
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Livewire/Concerns/Transfers/ReadsTransferRegister.php
            count: 5
        -
            # ledgerLines(), stageCounts() and groupTotals() inline the same
            # state fragments, the group key from groupKeySql() (a fixed match on
            # the whitelisted group property) and fixed column names into their
            # aggregate selects; there is no user input in them.
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Livewire/Concerns/Transfers/ReadsTransferLedger.php
            count: 4
        -
            # amount(), percent() and amountAtLeast() return Number::format(),
            # which Laravel documents as string|false; percent() can also return
            # __('transfers.under_a_tenth_of_a_percent'), which PHPStan types as
            # string|array (that key always resolves to a string). Number::format()
            # is false only when the intl formatter fails;
            # ensureIntlExtensionIsInstalled() already throws when the extension
            # is missing. The closures they came from declared string too, so
            # declaring a wider type would be a change.
            identifier: return.type
            path: app/Livewire/Concerns/Transfers/PresentsTransferRegister.php
            count: 3
        -
            # percent() hands that same Number::format() result (string|false)
            # to str_replace().
            identifier: argument.type
            path: app/Livewire/Concerns/Transfers/PresentsTransferRegister.php
            count: 1
        -
            # groupLabelOf() reads an account name as `account?->account_name ??
            # no_account`. transfers_tracking.account_id IS nullable (a tranche
            # may be scheduled before an account exists) and that fallback labels
            # those rows on purpose: keep it. PHPStan types the BelongsTo as
            # never null and flags only the `?->`, redundant on the left of `??`.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Transfers/ReadsTransferRegister.php
            count: 1

        # The donors/index traits hold code moved unchanged from the page, which
        # PHPStan could not read before. Changing any of it is a logic change, so
        # each entry stays.
        -
            # rows() passes AgreementMoney::ownerSelect(), and totals() passes
            # ownerTotalsSelect('donors.id'), to selectRaw(). Both
            # build the list from fixed column names; ownerTotalsSelect() also
            # checks its key against a pattern. Typed plain string.
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Livewire/Concerns/Donors/ReadsDonorRegister.php
            count: 2
        -
            # exportCsv() passes AgreementMoney::ownerSelect() to selectRaw(); same
            # fixed column list as rows() above.
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Livewire/Concerns/Donors/ExportsDonorRegister.php
            count: 1
        -
            # wallet() reads donor_id, currency and total off tranches fetched
            # with selectRaw('donor_proposal.donor_id as donor_id, ... as currency,
            # sum(...) as total'). They are aliases, not TransfersTracking
            # properties, and a closure parameter cannot carry a type that
            # overrides the one inferred from the collection (a @param on the
            # closure is ignored), so the three reads are reported.
            identifier: property.notFound
            path: app/Livewire/Concerns/Donors/ChartsDonorPortfolio.php
            count: 3
        -
            # upcomingTransfers() documents each row's date as non-null. The query
            # filters whereNotNull('scheduled_date'), but transfers_tracking.
            # scheduled_date is nullable (migration 2026_09_14_111851) and PHPStan
            # cannot see the filter, so the nullable cast is reported.
            identifier: return.type
            path: app/Livewire/Concerns/Donors/ChartsDonorPortfolio.php
            count: 1
        -
            # donorMoney() compares `amount_received_currency?->value` and
            # `amount_transfered_currency?->value`; both columns are NOT NULL
            # (default USD, never made nullable), so the `?->` is reported as
            # never meeting null.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Donors/ChartsDonorPortfolio.php
            count: 2
        -
            # moneyByCurrency() adds every value of agreementMoney()'s array shape
            # to the matching key of its running total, so PHPStan widens the
            # total's int `missingNet` to float|int and rejects the documented
            # `missingNet: int`. The loop does not tell it that key only ever
            # receives an int; splitting the sum per key is a logic change.
            identifier: return.type
            path: app/Livewire/Concerns/Donors/ReadsDonorMoney.php
            count: 1
        -
            # receivedElsewhere() tests `amount_received_currency !== null`, but
            # transfers_tracking.amount_received_currency is NOT NULL (default USD,
            # never made nullable) and TransfersTracking documents it as
            # `@property Currency` (non-null, from the enum cast), so PHPStan
            # takes the test as always true. Dropping it is a logic change.
            identifier: notIdentical.alwaysTrue
            path: app/Livewire/Concerns/Donors/ReadsDonorMoney.php
            count: 1
        -
            # amount() and shortAmount() return Number::format() and
            # Number::abbreviate(), which Laravel documents as string|false. They
            # are false only when the intl formatter fails;
            # ensureIntlExtensionIsInstalled() already throws when the extension
            # is missing. The closures they came from declared string too, so
            # declaring string|false would be a change.
            identifier: return.type
            path: app/Livewire/Concerns/Donors/PresentsDonorRegister.php
            count: 2

        # The admin/accounts traits hold code moved unchanged from the page, which
        # PHPStan could not read before. Changing any of it is a logic change.
        -
            # registerQuery() passes AccountMoney::select(), and totals() passes
            # AccountMoney::totalsSelect(), to selectRaw(). Both implode a fixed list
            # of column expressions with no input; they are typed plain string in
            # app/Support/AccountMoney.php, outside this page.
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Livewire/Concerns/Admin/ReadsAccountRegister.php
            count: 2

        # The dashboard/index traits hold code moved unchanged from the page,
        # which PHPStan could not read before. Changing any of it is a logic
        # change.
        -
            # Three redundant `?->`, each the last one on the left of a `??`, which
            # already covers null: `transfer->donorProposal?->donor?->name`,
            # `donorProposal?->proposal?->name` and `risk->project?->name`. The
            # '—' fallback is a defensive label for a dangling reference: keep it.
            identifier: nullsafe.neverNull
            path: app/Livewire/Concerns/Dashboard/ReadsDashboardAttention.php
            count: 3
        -
            # attentionItems() eager-loads `source` with a callback typed for the
            # MorphTo it receives (it calls morphWith()); Larastan types every
            # with() callback as taking any Relation.
            message: '#MorphTo#'
            identifier: argument.type
            path: app/Livewire/Concerns/Dashboard/ReadsDashboardAttention.php
            count: 1
        -
            # attentionItems() titles a transfer row with a `__()` call that
            # passes the Currency enum cast (`amount_transfered_currency`) as a
            # replacement. The stub accepts only scalars and closures;
            # Translator::makeReplacements() applies enum_value() to an object.
            message: '#\$replace of function __#'
            identifier: argument.type
            path: app/Livewire/Concerns/Dashboard/ReadsDashboardAttention.php
            count: 1
        -
            # Two redundant `?->`, each the last one on the left of a `??`, which
