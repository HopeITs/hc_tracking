        # The funding-agreements/index traits hold code moved unchanged from the
        # page, which PHPStan could not read before. Changing any of it is a
        # logic change.
        -
            # applyStage() builds its two whereRaw() conditions with the
            # $sameCurrencyTotal arrow function (fixed SQL around the agreement's
            # currency column, and the Received enum value for the received
            # stage), and totals() passes AgreementMoney::totalsSelect() to
            # selectRaw(); that list is built from fixed column names. Neither
            # holds user input. The arrow function's result is a plain string
            # because it concatenates its native `string $condition` parameter,
            # and a `@var Closure(literal-string): literal-string` is rejected:
            # closure parameters are contravariant, so narrowing the native
            # string parameter does not give a subtype of the inferred closure.
            message: '#expects (.+\|)?literal-string, .+ given#'
            identifier: argument.type
            path: app/Livewire/Concerns/FundingAgreements/ReadsAgreementRegister.php
            count: 3
        -
            # calendar() reads ar_status, transfer_date and scheduled_date off the
            # native `object $tranche` parameter of the three arrow functions it
            # hands to $sum(). They are stdClass rows from a toBase() query with
            # those columns selected, so the properties are real. But $sum() takes
            # a plain callable, so PHPStan knows only the native `object` type,
            # which declares no properties; it does not read a @param docblock on
            # an arrow function, and a typed @var on $sum is rejected because it
            # narrows the native callable parameter.
            identifier: property.notFound
            path: app/Livewire/Concerns/FundingAgreements/ChartsAgreementCalendar.php
