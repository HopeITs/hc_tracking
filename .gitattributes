* text=auto eol=lf

# Windows batch wrappers must keep CRLF line endings
*.cmd text eol=crlf
*.bat text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore
.github/workflows/browser-tests.yml export-ignore
