APP_NAME="HC Tracking"
APP_ENV=local
APP_TIMEZONE=Asia/Damascus
APP_KEY=
# Old keys (comma separated) still accepted for decryption while rotating APP_KEY.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hc_tracking
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

HR_DB_HOST=127.0.0.1
HR_DB_PORT=3306
HR_DB_DATABASE=hr_db
HR_DB_USERNAME=root
HR_DB_PASSWORD=
# Comma-separated HR emails that start as Super Admin on their first login.
HR_ADMIN_EMAILS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave empty to follow APP_URL: Secure cookies on https, plain on http.
SESSION_SECURE_COOKIE=

# Seconds before password confirmation is asked for again (900 = 15 minutes).
AUTH_PASSWORD_TIMEOUT=900
# Minutes a "remember me" login lasts (43200 = 30 days).
AUTH_REMEMBER_MINUTES=43200
# Secret for passkey user handles; leave empty to use APP_KEY (changing it orphans existing passkeys).
PASSKEYS_USER_HANDLE_SECRET=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Production live notifications without running anything on the server:
# BROADCAST_CONNECTION=pusher and QUEUE_CONNECTION=sync, then fill these in
# and rebuild assets (npm run build).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Super Admin, General Manager, Managers and Financial must turn on two-factor
# authentication before using the app. Only false/0/off/no switches this off.
AUTH_TWO_FACTOR_ENFORCED=true

# Reverse proxies (comma-separated IPs/CIDRs) whose X-Forwarded-For is trusted; empty trusts none.
TRUSTED_PROXIES=
